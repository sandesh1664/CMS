@import "tailwindcss";

:root {
  --bg: #f6f8fc;
  --ink: #1c2941;
  --muted: #8591a6;
  --border: #e7ebf3;
  --blue: #4169df;
}

* { box-sizing: border-box; }
html, body { min-height: 100%; }
body { margin: 0; background: var(--bg); color: var(--ink); font-family: Arial, Helvetica, sans-serif; font-size: 13px; }
button, input, select, textarea { font: inherit; }
button { cursor: pointer; }
button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 2px solid #8da8ff; outline-offset: 2px; }
.app-shell { min-height: 100vh; }
.sidebar { position: fixed; z-index: 30; inset: 0 auto 0 0; width: 250px; display: flex; flex-direction: column; padding: 23px 15px 13px; background: white; border-right: 1px solid var(--border); }
.brand { display: flex; align-items: center; gap: 10px; padding: 0 7px 25px; }
.brand-mark { width: 39px; height: 39px; display: grid; place-items: center; border-radius: 11px; background: linear-gradient(140deg,#6087f4,#3156c7); color: white; }
.brand-name { font-size: 18px; font-weight: 800; letter-spacing: -.6px; }
.brand-caption { margin-top: 3px; color: #9aa4b6; font-size: 9px; font-weight: 700; letter-spacing: 1.2px; }
.section-label { padding: 0 10px 10px; color: #9ba5b6; font-size: 9px; font-weight: 800; letter-spacing: 1px; }
.workspace-switch { display: flex; align-items: center; gap: 9px; padding: 10px; margin-bottom: 21px; border: 1px solid var(--border); border-radius: 9px; color: #7d899e; }
.workspace-avatar { width: 33px; height: 33px; display: grid; place-items: center; border-radius: 9px; background: #edf2ff; color: #4169df; font-weight: 800; }
.workspace-text,.user-details { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 4px; }
.workspace-text strong,.user-details strong { font-size: 11px; color: #34415a; }
.workspace-text span,.user-details span { font-size: 10px; color: #8b97aa; }
.side-nav { flex: 1; overflow-y: auto; }
.nav-label { margin-top: 12px; padding-bottom: 8px; }
.nav-item { width: 100%; display: flex; align-items: center; gap: 11px; margin: 2px 0; padding: 11px; border: 0; border-radius: 8px; background: transparent; color: #6e7b91; text-align: left; font-size: 12px; }
.nav-item span:nth-child(2) { flex: 1; }
.nav-item:hover { background: #f6f8fd; color: #3456b4; }
.nav-active { background: #edf2ff; color: #315acb; font-weight: 700; }
.nav-count { padding: 3px 6px; border-radius: 5px; background: white; font-size: 10px; }
.sidebar-bottom { margin-top: 12px; }
.help-card { padding: 13px; border: 1px solid #edf0f7; border-radius: 10px; background: #f8f9fd; }
.help-icon { margin-bottom: 8px; color: #5475d3; }
.help-card strong { display: block; font-size: 12px; }
.help-card p { margin: 6px 0 10px; color: #8390a5; font-size: 10px; line-height: 1.6; }
.help-card button { display: flex; align-items: center; gap: 5px; padding: 0; border: 0; background: transparent; color: #4169df; font-size: 11px; font-weight: 700; }
.sidebar-user { display: flex; align-items: center; gap: 9px; padding: 13px 2px 0; margin-top: 13px; border-top: 1px solid var(--border); }
.user-avatar { width: 33px; height: 33px; display: grid; place-items: center; flex-shrink: 0; border-radius: 50%; background: #e9edff; color: #4564c5; font-size: 10px; font-weight: 800; }
.icon-button { position: relative; display: inline-grid; place-items: center; width: 34px; height: 34px; flex-shrink: 0; border: 1px solid transparent; border-radius: 8px; background: transparent; color: #718097; }
.icon-button:hover { background: #f4f6fb; border-color: #e8ebf2; }
.mobile-close,.mobile-menu { display: none; }
.main-area { min-height: 100vh; margin-left: 250px; }
.topbar { position: sticky; top: 0; z-index: 20; height: 65px; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 0 32px; border-bottom: 1px solid var(--border); background: #ffffffed; backdrop-filter: blur(12px); }
.breadcrumb { display: flex; align-items: center; gap: 11px; color: #929db0; font-size: 12px; }
.breadcrumb strong { color: #2a3751; }
.slash { color: #c6cddb; }
.top-actions { display: flex; align-items: center; gap: 13px; }
.global-search,.table-search { display: flex; align-items: center; gap: 8px; border: 1px solid var(--border); border-radius: 8px; padding: 9px 10px; background: white; color: #8995a9; }
.global-search { width: 220px; }
.global-search input,.table-search input { width: 100%; min-width: 0; border: 0; outline: none; background: transparent; color: #33415a; font-size: 11px; }
.notification-button { border-color: var(--border); }
.notification-dot { position: absolute; top: 6px; right: 6px; width: 7px; height: 7px; border: 1.5px solid white; border-radius: 50%; background: #ec6d70; }
.top-user { display: flex; align-items: center; gap: 7px; color: #7e8aa0; }
.page-content { max-width: 1600px; margin: 0 auto; padding: 31px 32px 22px; }
.welcome-row { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-bottom: 23px; }
.eyebrow { display: flex; align-items: center; gap: 7px; color: #8793a8; font-size: 9px; font-weight: 800; letter-spacing: 1.2px; }
.live-dot,.online-dot { width: 7px; height: 7px; display: inline-block; border-radius: 50%; background: #46b984; }
.welcome-row h1 { margin: 10px 0 6px; font-size: clamp(23px,2.2vw,30px); font-weight: 800; letter-spacing: -1px; }
.subtitle { margin: 0; color: #8591a6; font-size: 12px; }
.welcome-actions { display: flex; gap: 9px; }
.button-primary,.button-secondary { display: inline-flex; align-items: center; justify-content: center; gap: 7px; padding: 10px 13px; border: 1px solid transparent; border-radius: 8px; font-size: 11px; font-weight: 700; white-space: nowrap; }
.button-primary { background: #4169df; color: white; box-shadow: 0 2px 4px #4169df20; }
.button-primary:hover { background: #3156c7; }
.button-secondary { border-color: #e1e6f0; background: white; color: #5b6880; }
.button-secondary:hover { background: #f7f9fd; }
.notice-banner { display: flex; align-items: center; gap: 12px; margin-bottom: 19px; padding: 13px 15px; border: 1px solid #e3eaff; border-radius: 10px; background: linear-gradient(105deg,#f0f4ff,#fafbff); }
.notice-icon { display: grid; place-items: center; width: 36px; height: 36px; flex-shrink: 0; border: 1px solid #e2e9ff; border-radius: 9px; background: white; color: #4770d9; }
.notice-copy { display: flex; flex-direction: column; gap: 4px; }
.notice-copy strong { font-size: 11px; }
.notice-copy span { color: #8390a7; font-size: 10px; }
.demo-pill { display: inline-flex; align-items: center; gap: 6px; margin-left: auto; color: #6d7c96; font-size: 10px; white-space: nowrap; }
.demo-pill span { width: 6px; height: 6px; border-radius: 50%; background: #48b985; }
.stats-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 14px; margin-bottom: 19px; }
.stat-card,.panel { min-width: 0; border: 1px solid var(--border); border-radius: 11px; background: white; box-shadow: 0 2px 6px #203a6b05; }
.stat-card { padding: 16px 17px; }
.stat-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 13px; }
.stat-icon { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 9px; }
.stat-icon.blue { background: #edf2ff; color: #4770df; }
.stat-icon.green { background: #e8f8f0; color: #32a575; }
.stat-icon.amber { background: #fff4df; color: #d39828; }
.stat-icon.purple { background: #f2ecff; color: #8963d3; }
.stat-menu { color: #8995a9; font-size: 19px; letter-spacing: 1px; }
.stat-title { color: #7f8ba0; font-size: 11px; }
.stat-value { margin: 7px 0 10px; font-size: clamp(24px,2.4vw,30px); font-weight: 800; letter-spacing: -.7px; }
.stat-foot { display: flex; align-items: center; gap: 6px; color: #929db0; font-size: 10px; }
.foot-dot { width: 6px; height: 6px; border-radius: 50%; background: #aab6c9; }
.middle-grid { display: grid; grid-template-columns: minmax(0,1.5fr) minmax(290px,1fr); gap: 16px; margin-bottom: 19px; }
.panel { padding: 18px; }
.panel-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
.panel-heading h2 { margin: 0; font-size: 13px; font-weight: 800; }
.panel-heading p { margin: 6px 0 0; color: #929db0; font-size: 10px; }
.period-chip { display: flex; align-items: center; gap: 8px; padding: 7px 9px; border: 1px solid var(--border); border-radius: 7px; color: #6e7a90; font-size: 10px; white-space: nowrap; }
.chart-legend { display: flex; gap: 16px; margin: 20px 0 12px 28px; color: #7f8ba0; font-size: 10px; }
.chart-legend span { display: flex; align-items: center; gap: 6px; }
.chart-legend i { width: 7px; height: 7px; border-radius: 2px; }
.legend-blue { background: #4779ed; }
.legend-gray { background: #aab5c7; }
.chart-area { display: flex; gap: 12px; height: 165px; }
.y-labels { display: flex; flex-direction: column; justify-content: space-between; padding-bottom: 23px; color: #9ba5b6; font-size: 9px; }
.chart-main { position: relative; flex: 1; min-width: 0; }
.chart-gridlines { position: absolute; inset: 0 0 23px; display: flex; flex-direction: column; justify-content: space-between; }
.chart-gridlines i { border-top: 1px dashed #edf0f5; }
.chart-svg { position: absolute; inset: 0 0 23px; width: 100%; height: calc(100% - 23px); overflow: visible; }
.x-labels { position: absolute; right: 0; bottom: 0; left: 0; display: flex; justify-content: space-between; color: #9ba5b6; font-size: 9px; }
.chart-footnote { margin-top: 13px; padding-top: 11px; border-top: 1px solid #edf0f5; color: #99a3b4; font-size: 10px; }
.outcome-body { display: flex; align-items: center; justify-content: space-around; gap: 14px; padding: 23px 0 20px; }
.donut { position: relative; display: grid; place-items: center; width: 137px; height: 137px; flex-shrink: 0; border-radius: 50%; background: conic-gradient(#4779ed 0 64%,#aeb9ca 64% 87%,#f0bc56 87% 95%,#e47777 95% 100%); }
.donut::before { position: absolute; width: 96px; height: 96px; border-radius: 50%; background: white; content: ""; }
.donut-center { position: relative; display: flex; flex-direction: column; align-items: center; gap: 5px; }
.donut-center strong { font-size: 22px; letter-spacing: -.6px; }
.donut-center span { color: #8995a9; font-size: 10px; }
.outcome-legend { display: flex; flex: 1; min-width: 115px; flex-direction: column; gap: 15px; }
.outcome-legend div { display: grid; grid-template-columns: 8px 1fr auto; align-items: center; gap: 7px; font-size: 10px; }
.outcome-legend span { color: #7e8aa0; }
.outcome-legend strong { font-size: 10px; }
.outcome-legend i { width: 7px; height: 7px; border-radius: 2px; }
.o-blue { background: #4779ed; }.o-gray { background: #aeb9ca; }.o-amber { background: #f0bc56; }.o-red { background: #e47777; }
.players-panel { padding: 18px 0 0; }
.players-heading { padding: 0 18px 17px; }
.text-link { display: inline-flex; align-items: center; gap: 6px; padding: 4px 0; border: 0; background: transparent; color: #4169d9; font-size: 10px; font-weight: 700; white-space: nowrap; }
.table-toolbar { display: flex; align-items: center; gap: 9px; padding: 11px 18px; border-top: 1px solid #edf0f5; border-bottom: 1px solid #edf0f5; }
.table-search { width: min(320px,100%); flex: 1; }
.filter-select { max-width: 190px; border: 1px solid var(--border); border-radius: 8px; padding: 9px; background: white; color: #69768d; font-size: 10px; }
.small-button { padding: 9px 11px; }
.table-scroll { width: 100%; overflow-x: auto; }
.players-table { width: 100%; border-collapse: collapse; text-align: left; white-space: nowrap; }
.players-table th { padding: 12px 12px; background: #fafbfe; color: #929db0; font-size: 9px; font-weight: 800; letter-spacing: .5px; }
.players-table td { padding: 11px 12px; border-top: 1px solid #eff1f6; color: #65728a; font-size: 10px; }
.players-table tbody tr:hover { background: #fafbff; }
.players-table th:first-child,.players-table td:first-child { padding-left: 18px; }
.player-cell { display: flex; align-items: center; gap: 9px; }
.player-avatar { display: grid; place-items: center; width: 32px; height: 32px; flex-shrink: 0; border-radius: 9px; background: #edf1ff; color: #4766b9; font-size: 10px; font-weight: 800; }
.player-cell>div:last-child { display: flex; flex-direction: column; gap: 4px; }
.player-cell strong { color: #35425b; font-size: 10px; }
.player-cell span { color: #9aa4b5; font-size: 9px; }
.status-badge { display: inline-flex; align-items: center; gap: 6px; padding: 5px 7px; border-radius: 5px; font-size: 9px; font-weight: 700; }
.status-dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
.status-badge.green { background: #e9f8f0; color: #269365; }
.status-badge.gray { background: #f0f2f6; color: #778398; }
.status-badge.red { background: #fff0f0; color: #d45d63; }
.status-badge.amber { background: #fff5e3; color: #b98121; }
.status-badge.purple { background: #f3edff; color: #815bc0; }
.contact-time { display: inline-flex; align-items: center; gap: 5px; color: #7d899f; }
.contact-time svg { color: #a5afbf; }
.row-action { border: 0; background: transparent; color: #8995a9; font-size: 18px; }
.empty-row { padding: 28px !important; text-align: center; color: #929db0 !important; }
.table-footer { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 13px 18px; border-top: 1px solid #edf0f5; color: #929db0; font-size: 10px; }
.table-footer strong { color: #46536b; }
.followup-panel { margin-top: 18px; }
.followup-list { margin-top: 15px; }
.followup-row { display: flex; align-items: center; gap: 11px; padding: 12px 0; border-top: 1px solid #eff1f6; }
.check-button { display: grid; place-items: center; width: 20px; height: 20px; border: 1px solid #dbe2ee; border-radius: 6px; background: white; color: white; }
.check-button:hover,.followup-done .check-button { border-color: #41ac80; background: #41ac80; }
.followup-person { display: flex; flex: 1; flex-direction: column; gap: 4px; }
.followup-person strong { font-size: 11px; }
.followup-person span { color: #909bae; font-size: 10px; }
.followup-time { display: flex; align-items: center; gap: 6px; color: #77859c; font-size: 10px; }
.followup-done .followup-person strong { color: #929db0; text-decoration: line-through; }
.page-footer { display: flex; justify-content: space-between; gap: 12px; padding: 22px 2px 0; color: #9ba5b6; font-size: 10px; }
.online-dot { width: 6px; height: 6px; margin-right: 5px; }
.toast { position: fixed; right: 22px; bottom: 22px; z-index: 90; display: flex; align-items: center; gap: 10px; max-width: min(430px,calc(100vw - 32px)); padding: 14px; border: 1px solid #dcefe5; border-radius: 10px; background: white; color: #327957; box-shadow: 0 12px 38px #17233b1c; font-size: 12px; }
.toast span { flex: 1; }
.toast button { display: grid; place-items: center; border: 0; background: transparent; color: #7b8a9c; }
.modal-backdrop { position: fixed; inset: 0; z-index: 70; display: grid; place-items: center; padding: 18px; background: #17233b72; backdrop-filter: blur(3px); }
.call-modal { width: min(470px,100%); padding: 23px; border: 1px solid var(--border); border-radius: 14px; background: white; box-shadow: 0 24px 80px #111d382e; }
.modal-heading { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 22px; }
.modal-heading h2 { margin: 0; font-size: 19px; letter-spacing: -.4px; }
.modal-heading p { margin: 6px 0 0; color: #8792a7; font-size: 11px; }
.form-label { display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px; color: #45536d; font-size: 11px; font-weight: 700; }
.form-label select,.form-label textarea { width: 100%; border: 1px solid #dfe4ee; border-radius: 8px; padding: 11px; color: #35445d; background: white; font-size: 12px; }
.form-label textarea { resize: vertical; }
.modal-hint { display: flex; align-items: flex-start; gap: 8px; padding: 11px; border-radius: 8px; background: #f6f8fc; color: #7c899e; font-size: 10px; line-height: 1.5; }
.modal-hint svg { flex-shrink: 0; color: #5d79cb; }
.modal-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 22px; }
.mobile-overlay { display: none; }

@media (min-width: 1600px) { .page-content { padding-top: 40px; } }
@media (max-width: 1250px) {
  .sidebar { width: 225px; }
  .main-area { margin-left: 225px; }
  .page-content { padding: 26px 22px 20px; }
  .topbar { padding: 0 22px; }
  .stats-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
  .middle-grid { grid-template-columns: 1fr; }
}
@media (max-width: 760px) {
  .sidebar { width: 270px; transform: translateX(-102%); transition: transform .22s ease; box-shadow: 12px 0 35px #1b29431a; }
  .sidebar-open { transform: translateX(0); }
  .mobile-overlay { display: block; position: fixed; inset: 0; z-index: 25; border: 0; background: #18253e66; }
  .mobile-close { display: inline-grid; margin-left: auto; }
  .main-area { margin-left: 0; }
  .topbar { height: 59px; padding: 0 12px; gap: 7px; }
  .mobile-menu { display: inline-grid; }
  .breadcrumb { flex: 1; gap: 7px; }
  .top-actions { gap: 5px; }
  .global-search { width: 35px; height: 35px; justify-content: center; padding: 7px; border-color: transparent; background: transparent; }
  .global-search input,.top-user { display: none; }
  .page-content { padding: 22px 13px 17px; }
  .welcome-row { align-items: flex-start; flex-direction: column; gap: 15px; }
  .welcome-actions { width: 100%; }
  .welcome-actions button { flex: 1; }
  .notice-banner { padding: 11px; }
  .notice-copy span { line-height: 1.5; }
  .demo-pill { display: none; }
  .stats-grid { gap: 10px; }
  .stat-card { padding: 12px; }
  .stat-value { font-size: 25px; }
  .middle-grid { gap: 12px; }
  .panel { padding: 14px; }
  .players-panel { padding: 14px 0 0; }
  .players-heading { padding: 0 14px 14px; }
  .table-toolbar { flex-wrap: wrap; padding: 10px 12px; }
  .table-search { min-width: 100%; }
  .players-table th:first-child,.players-table td:first-child { padding-left: 13px; }
  .page-footer { flex-wrap: wrap; }
}
@media (max-width: 390px) {
  .stats-grid { grid-template-columns: 1fr; }
  .stat-foot { flex-wrap: wrap; }
  .outcome-body { flex-direction: column; }
  .outcome-legend { width: 100%; }
  .welcome-actions { flex-wrap: wrap; }
  .welcome-actions button { min-width: 125px; }
}

/* Admin / Staff preview selector */
.role-preview {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 5px 8px;
  border: 1px solid #e5e7eb;
  border-radius: 9px;
  background: #fff;
  color: #64748b;
  font-size: 12px;
  white-space: nowrap;
}

.role-preview select {
  max-width: 100px;
  border: 0;
  outline: none;
  background: transparent;
  color: #172033;
  font: inherit;
  font-weight: 600;
  cursor: pointer;
}

@media (max-width: 640px) {
  .role-preview {
    gap: 4px;
    padding: 5px;
  }

  .role-preview > span {
    display: none;
  }

  .role-preview select {
    max-width: 75px;
  }
}
